% config.sty - Configuración de estilo para Plantilla de Reporte Miniproyectos 2026
% Universidad Autónoma de Aguascalientes - Centro de Ciencias Básicas

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{config}[2026/08/26 Configuración Miniproyectos UAA]

% ================================
% PAQUETES NECESARIOS
% ================================
\RequirePackage[utf8]{inputenc}
\RequirePackage[spanish,es-tabla]{babel}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{setspace}
\RequirePackage{enumitem}
\RequirePackage{tcolorbox}
\RequirePackage{booktabs}
\RequirePackage{caption}
\RequirePackage{float}
\usepackage{transparent}
% ================================
% PALETA DE COLORES UAA
% ================================
% Colores principales UAA
\definecolor{UAARed}{RGB}{98,36,35}        % Rojo UAA principal
\definecolor{UAADarkRed}{RGB}{153,0,38}    % Rojo UAA oscuro
\definecolor{UAAGray}{RGB}{102,102,102}    % Gris UAA
\definecolor{UAALightGray}{RGB}{230,230,230} % Gris claro
\definecolor{UAABlue}{RGB}{0,51,102}       % Azul UAA
\definecolor{UAAGold}{RGB}{255,204,0}      % Dorado UAA

% Colores de texto
\definecolor{TextPrimary}{RGB}{51,51,51}   % Texto principal
\definecolor{TextSecondary}{RGB}{102,102,102} % Texto secundario
\definecolor{SectionColor}{RGB}{98,36,35}  % Color de secciones
\definecolor{HeaderColor}{RGB}{11,37,69}   % Color #622423 para textbf de ficha

% ================================
% CONFIGURACIÓN DE PÁGINA
% ================================
\geometry{
    a4paper,
    left=2.5cm,
    right=2.5cm,
    top=3cm,
    bottom=2.5cm,
    headheight=1.5cm,
    headsep=1cm,
    footskip=1cm
}

% ================================
% CONFIGURACIÓN DE FUENTES Y ESPACIADO
% ================================
% Espaciado de líneas
\setstretch{1.2}

% Configuración de párrafos
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt plus 2pt minus 1pt}

% ================================
% ESTILOS DE SECCIONES
% ================================
% Formato para el título principal (sin barras de color)
\titleformat{\section}
    {\Large\bfseries\color{SectionColor}}
    {}
    {0pt}
    {}

% Formato para subsecciones
\titleformat{\subsection}
    {\large\bfseries\color{SectionColor}}
    {}
    {0pt}
    {}

% Espaciado de secciones
\titlespacing*{\section}{0pt}{20pt plus 4pt minus 2pt}{10pt plus 2pt minus 2pt}
\titlespacing*{\subsection}{0pt}{15pt plus 3pt minus 2pt}{8pt plus 2pt minus 2pt}

% ================================
% ENCABEZADO Y PIE DE PÁGINA
% ================================
\pagestyle{fancy}
\fancyhf{}

% Ajustar altura del encabezado
\setlength{\headheight}{30pt}

% Encabezado


\fancyhead[L]{\raisebox{-4pt}{\transparent{0.3}\includegraphics[height=1.3cm]{UAA.png}}}
\fancyhead[C]{\small\textcolor{TextSecondary}{Centro de Ciencias Básicas | Miniproyectos 2026 | Reporte}}
\fancyhead[R]{}

% Pie de página
\fancyfoot[C]{\small\textcolor{TextSecondary}{Plantilla de reporte | Miniproyectos 2026 | Página \thepage}}

% Línea de separación en encabezado
\renewcommand{\headrulewidth}{0.8pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{UAARed}\leaders\hrule height \headrulewidth\hfill}}

% Sin línea en pie de página
\renewcommand{\footrulewidth}{0pt}

% ================================
% CONFIGURACIÓN DE LISTAS
% ================================
\setlist[itemize]{
    leftmargin=*,
    itemsep=2pt,
    parsep=0pt,
    topsep=4pt
}

\setlist[enumerate]{
    leftmargin=*,
    itemsep=2pt,
    parsep=0pt,
    topsep=4pt
}

% ================================
% CAJAS DE INFORMACIÓN
% ================================
% Caja para información del proyecto
\newtcolorbox{projectinfo}{
    colback=UAALightGray,
    colframe=UAARed,
    boxrule=1pt,
    arc=3pt,
    left=8pt,
    right=8pt,
    top=8pt,
    bottom=8pt
}

% Caja para orientaciones
\newtcolorbox{orientation}{
    colback=white,
    colframe=UAAGray,
    boxrule=0.5pt,
    arc=2pt,
    left=6pt,
    right=6pt,
    top=6pt,
    bottom=6pt,
    fontupper=\small\itshape
}

% Caja para contenido de secciones (formato ficha)
\newtcolorbox{sectioncontent}{
    colback=white,
    colframe=UAALightGray,
    boxrule=0.5pt,
    arc=0pt,
    left=8pt,
    right=8pt,
    top=6pt,
    bottom=6pt,
    fontupper=\small
}

% ================================
% COMANDOS PERSONALIZADOS
% ================================
% Comando para el título del documento
\newcommand{\doctitle}[3]{
    \begin{center}
        {\fontsize{10}{12}\selectfont\bfseries\color{UAARed} #1}\\[8pt]
        {\fontsize{18}{22}\selectfont\bfseries\color{HeaderColor} #2}\\[5pt]
        {\small\itshape\color{TextSecondary} #3}
    \end{center}
    \vspace{15pt}
}

% Comando para información del proyecto (con color específico)
\newcommand{\projectdata}[4]{
    \textcolor{UAARed}{\textbf{Clave del miniproyecto:}} #1\\[3pt]
    \textcolor{UAARed}{\textbf{Título del miniproyecto:}} #2\\[3pt]
    \textcolor{UAARed}{\textbf{Autores:}} #3\\[3pt]
    \textcolor{UAARed}{\textbf{Adscripciones:}} #4\\[15pt]
}

% ================================
% CONFIGURACIÓN DE TABLAS Y FIGURAS
% ================================
% Configuración de caption
\captionsetup{
    font=small,
    labelfont={bf,color=SectionColor},
    textfont=normal,
    justification=centering,
    singlelinecheck=false,
    skip=8pt
}

% ================================
% ESPACIADO ADICIONAL
% ================================
% Espaciado antes y después de elementos flotantes
\setlength{\floatsep}{12pt plus 2pt minus 2pt}
\setlength{\textfloatsep}{20pt plus 2pt minus 4pt}
\setlength{\intextsep}{14pt plus 2pt minus 2pt}

% ================================
% CONFIGURACIONES FINALES
% ================================
% Evitar huérfanas y viudas
\widowpenalty=10000
\clubpenalty=10000

% Configurar profundidad de numeración
\setcounter{secnumdepth}{0} % Sin numeración automática de secciones
\setcounter{tocdepth}{2}

\endinput